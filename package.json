{
  "name": "ofeliya-hub",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Хаб мини-игр для мессенджера MAX. Фронтенд — статика без сборки; сервер событий и бот — Node.",
  "scripts": {
    "dev": "npx --yes serve . -l 5173",
    "server": "node --env-file=.env server/index.mjs",
    "bot": "node --env-file=.env bot/index.mjs",
    "vendor": "node tools/vendor.mjs",
    "check": "node tools/check.mjs",
    "smoke": "node tools/check.mjs && node server/smoke.mjs && node bot/smoke.mjs && node tools/daily.mjs && node tools/duel.mjs",
    "smoke:server": "node server/smoke.mjs",
    "smoke:bot": "node bot/smoke.mjs",
    "smoke:daily": "node tools/daily.mjs",
    "smoke:duel": "node tools/duel.mjs"
  },
  "dependencies": {
    "@maxhub/max-bot-api": "^0.3.1",
    "fastify": "^5.2.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0"
  }
}
