# Скопируйте в .env и заполните. Файл .env не должен попадать в git.

# ── Бот ──────────────────────────────────────────────────────────────────
BOT_TOKEN=

# MAX user_id администраторов бота, кому доступны /cast и /stats.
# Пустой список = админских команд нет ни у кого (fail closed).
HUB_ADMIN_IDS=

HUB_WEBAPP_URL=https://games.example.ru
HUB_BOT_USERNAME=id0000000000_bot

# В production long polling запрещён: укажите публичный HTTPS webhook.
HUB_BOT_WEBHOOK_DOMAIN=https://games.example.ru
HUB_BOT_WEBHOOK_PORT=8788
HUB_BOT_WEBHOOK_PATH=/hub/bot/webhook
HUB_BOT_WEBHOOK_SECRET=

# По умолчанию identity-bearing уведомления отключены. Для true заполните
# реальные публичные реквизиты ниже; production иначе откажется стартовать.
HUB_NOTIFICATIONS_ENABLED=false
HUB_ORG_NAME=
HUB_ORG_INN=
HUB_POLICY_URL=
HUB_OFFER_URL=
HUB_SITE_URL=
HUB_SUPPORT_EMAIL=
HUB_AGE_RATING=12+

# ── Сервер событий ───────────────────────────────────────────────────────
PORT=8787
HUB_CORS_ORIGIN=https://games.example.ru

# Отдельный длинный секрет для серверных GET /stats и /export.csv.
# Передавать как Authorization: Bearer <token>.
HUB_ADMIN_TOKEN=

# Максимальный возраст подписанного MAX initData в секундах.
# MAX рекомендует интервал около 1 часа; это и есть безопасный default.
HUB_MAX_AUTH_AGE_SECONDS=3600

# ── Хранилище ────────────────────────────────────────────────────────────
# JSON — только dev/test. Для совместной работы server + bot используйте Postgres.
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/hub

# ── Хранение и лимиты ────────────────────────────────────────────────────
# Сроки хранения. События по умолчанию 90 дней — это верхняя граница окна
# /stats, поэтому продуктовое решение не принимается по данным старше
# retention.events. Подписчики 365 дней и удаляются по последнему реальному
# контакту, а не по дате подписки: иначе политика молча отключала бы
# уведомления у всех давно подписанных без возможности переподписаться.
HUB_EVENT_RETENTION_DAYS=90
HUB_SUBSCRIBER_RETENTION_DAYS=365
# Планировщик очистки в процессе server. HUB_RETENTION_DISABLED=true
# отключает его (нужно, если очистку выполняет внешняя cron-задача).
HUB_RETENTION_INTERVAL_HOURS=24
HUB_RETENTION_DISABLED=false

# Лимиты частоты на IP. Раньше это было пожелание в PRODUCTION_RUNBOOK без
# реализации, и внешнего ingress в deploy/ нет.
HUB_RATE_LIMIT_EV=120
HUB_RATE_LIMIT_SUB=20
HUB_RATE_LIMIT_FORGET=20
HUB_RATE_LIMIT_ADMIN=10
HUB_RATE_LIMIT_DISABLED=false

# Ограничение выгрузки /export.csv. Ответ помечается X-Hub-Export-Truncated,
# если выгрузка упёрлась в потолок.
HUB_EXPORT_LIMIT=50000

# ── Безопасность ─────────────────────────────────────────────────────────
# Обязательный секрет >=32 символов. Никакого production default нет.
HUB_HASH_SALT=
