# Скопируйте в .env и заполните. Файл .env не должен попадать в git.

# ── Бот ──────────────────────────────────────────────────────────────────
BOT_TOKEN=

# MAX user_id администраторов бота, кому доступны /cast и /stats.
# Пустой список = админских команд нет ни у кого (fail closed).
HUB_ADMIN_IDS=

HUB_WEBAPP_URL=https://games.example.ru
HUB_BOT_USERNAME=id0000000000_bot

# ── Сервер событий ───────────────────────────────────────────────────────
PORT=8787
HUB_CORS_ORIGIN=https://games.example.ru

# Отдельный длинный секрет для серверных GET /stats и /export.csv.
# Передавать как Authorization: Bearer <token>.
HUB_ADMIN_TOKEN=

# Максимальный возраст подписанного MAX initData в секундах.
# MAX рекомендует интервал около 1 часа; это и есть безопасный default.
HUB_MAX_AUTH_AGE_SECONDS=3600

# ── Хранилище ────────────────────────────────────────────────────────────
# JSON — только dev/test. Для совместной работы server + bot используйте Postgres.
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/hub

# ── Безопасность ─────────────────────────────────────────────────────────
# Обязательный секрет >=32 символов. Никакого production default нет.
HUB_HASH_SALT=
