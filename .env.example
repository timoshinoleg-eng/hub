# Скопируйте в .env и заполните. Файл .env не должен попадать в git.

# ── Бот ──────────────────────────────────────────────────────────────────
# business.max.ru → Чат-боты → Перейти → Расширенные настройки → Настроить
BOT_TOKEN=

# Telegram-подобные id администраторов, кому доступны /cast и /stats (через запятую)
HUB_ADMIN_IDS=

# URL мини-приложения (тот же, что указан в карточке бота)
HUB_WEBAPP_URL=https://games.example.ru

# Ник бота — платформа генерирует его сама (id<ИНН>_bot), изменить нельзя.
# Нужен, чтобы кнопки вели сразу в игру: https://max.ru/<ник>?startapp=g<игра>
HUB_BOT_USERNAME=id0000000000_bot

# ── Сервер событий ───────────────────────────────────────────────────────
PORT=8787
# Разрешённый источник для CORS. В продакшене — домен мини-приложения.
HUB_CORS_ORIGIN=https://games.example.ru

# ── Хранилище ────────────────────────────────────────────────────────────
# Без DATABASE_URL сервер пишет в server/data.json — этого хватит на софт-лонч.
# Для продакшена — Postgres на территории РФ (152-ФЗ).
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/hub

# ── Безопасность ─────────────────────────────────────────────────────────
# Соль для HMAC-хеширования идентификаторов. Придумайте длинную случайную строку.
# Смена соли делает старую аналитику несвязной с новой.
HUB_HASH_SALT=change-me-in-production
